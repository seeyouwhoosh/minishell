      "isDeleted": false,
      "boundElements": null,
      "updated": 1762458472089,
      "link": null,
      "locked": false,
      "text": "Nota: >& file, &> file ó 2> file se usa para el std error\nUna forma de redirigir el standard error al mismo sitio\nque el standard output es > file 2> &1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nota: >& file, &> file ó 2> file se usa para el std error\nUna forma de redirigir el standard error al mismo sitio que el standard output es > file 2> &1",
      "autoResize": false,
      "lineHeight": 1.25
    },
