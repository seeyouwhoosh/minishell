      "index": "a6zzzV",
      "roundness": null,
      "seed": 1642104918,
      "version": 713,
      "versionNonce": 1209385046,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1762458472089,
      "link": null,
      "locked": false,
      "text": "- [ ] < should redirect input.\n- [ ] > should redirect output.\n- [ ] << should be given a delimiter, then read the input until\na line containing the delimiter is seen. \n- [ ] >> should redirect output in append mode.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- [ ] < should redirect input.\n- [ ] > should redirect output.\n- [ ] << should be given a delimiter, then read the input until a line containing the delimiter is seen. \n- [ ] >> should redirect output in append mode.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "nVI2C-d0SpfbmZwV1ZeXq",
      "type": "text",
      "x": 899.4215747492653,
      "y": 42.39247303625143,
      "width": 442.2993774414062,
