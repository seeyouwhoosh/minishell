      "text": "- [ ] echo with option -n\n- [ ] cd with only a relative or absolute path\n- [ ] pwd with no options\n- [ ] unset with no options\n- [ ] export with no options\n- [ ] env with no options or arguments\n- [ ] exit with no options",
