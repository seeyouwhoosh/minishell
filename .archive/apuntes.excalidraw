      "index": "a5zzl",
      "roundness": null,
      "seed": 2061258765,
      "version": 990,
      "versionNonce": 1917296406,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762458462437,
      "link": null,
      "locked": false,
      "text": "- [ ] Manejar \"...\" (no expande los caracteres especiales excepto el dólar) y '...'\n(no expande nada, todo es literal)\n\n\n\n\n\n- [ ] Expandir variables de entorno: $ALGO\n\n- [ ] Manejar $?, que expande a el exit status de la última línea de comando",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- [ ] Manejar \"...\" (no expande los caracteres especiales excepto el dólar) y '...' (no expande nada, todo es literal)\n\n\n\n\n\n- [ ] Expandir variables de entorno: $ALGO\n\n- [ ] Manejar $?, que expande a el exit status de la última línea de comando",
      "autoResize": false,
      "lineHeight": 1.25
    },
