    {
      "id": "oEnSDdwvwcrvAup8o0UEg",
      "type": "text",
      "x": 1652.965225542916,
      "y": -285.9845110907322,
      "width": 404.43927001953125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
