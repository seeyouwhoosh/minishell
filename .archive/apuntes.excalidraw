    {
      "id": "mklNTh838l96Za8g01ODq",
      "type": "text",
      "x": 902.1715747492653,
      "y": -107.85752696374857,
      "width": 604.7393798828127,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
